{
  "comments": {},
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["|", "|"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "$", "close": "$" },
    { "open": "**", "close": "**" },
    { "open": "__", "close": "__" },
    { "open": "~~", "close": "~~" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["`", "`"],
    ["$", "$"],
    ["*", "*"],
    ["_", "_"],
    ["~", "~"],
    ["|", "|"]
  ],
  "folding": {
    "markers": {
      "start": "^\\|>",
      "end": "^/>"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\$\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
